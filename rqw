-- ========== SEMBUNYIKAN PLAYER LAIN ==========
setStatus("👥 Menyembunyikan player lain...", Color3.fromRGB(180, 180, 255))

local function hideCharacter(otherChar)
    if not otherChar then return end

    -- Sembunyikan semua BasePart & Decal
    for _, part in pairs(otherChar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = 1
            part.CastShadow = false
        elseif part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = 1
        elseif part:IsA("BillboardGui") or part:IsA("SurfaceGui") then
            part.Enabled = false
        elseif part:IsA("ParticleEmitter") or part:IsA("Trail") or
               part:IsA("Beam") or part:IsA("Fire") or
               part:IsA("Smoke") or part:IsA("Sparkles") then
            part.Enabled = false
        end
    end

    -- Sembunyikan nameplate
    local humanoid = otherChar:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
    end
end

local function hookPlayer(otherPlayer)
    if otherPlayer == player then return end

    -- Hide karakter saat ini
    if otherPlayer.Character then
        hideCharacter(otherPlayer.Character)
    end

    -- Hook CharacterAdded agar hide otomatis saat respawn
    otherPlayer.CharacterAdded:Connect(function(newChar)
        -- Tunggu karakter fully loaded
        newChar:WaitForChild("HumanoidRootPart", 5)
        task.wait(0.2)
        hideCharacter(newChar)
        -- Re-apply setelah beberapa detik (kadang part load telat)
        task.wait(1)
        hideCharacter(newChar)
    end)
end

-- Hook semua player yang sudah ada
for _, otherPlayer in pairs(game.Players:GetPlayers()) do
    hookPlayer(otherPlayer)
end

-- Hook player yang join setelahnya
game.Players.PlayerAdded:Connect(function(otherPlayer)
    hookPlayer(otherPlayer)
end)

-- Loop berkala setiap 3 detik untuk re-hide (mengatasi part yang load telat)
task.spawn(function()
    while true do
        for _, otherPlayer in pairs(game.Players:GetPlayers()) do
            if otherPlayer ~= player and otherPlayer.Character then
                hideCharacter(otherPlayer.Character)
            end
        end
        task.wait(3)
    end
end)

