local function findRFAfter(anchorName)
    local found = false
    for _, obj in ipairs(netFolder:GetChildren()) do
        if obj:IsA("RemoteFunction") then
            if obj.Name == anchorName then
                found = true
            elseif found then
                local nama = string.sub(obj.Name, 4)
                if #nama > 5 and string.find(nama, "[%p%s]") then
                    return obj
                end
            end
        end
    end
    return nil
end

local function findREAfter(anchorName)
    local found = false
    for _, obj in ipairs(netFolder:GetChildren()) do
        if obj:IsA("RemoteEvent") then
            if obj.Name == anchorName then
                found = true
            elseif found and string.sub(obj.Name, 1, 3) == "RE/" then
                local nama = string.sub(obj.Name, 4)
                if #nama > 10 and string.find(nama, "[%p%s]") then
                    return obj
                end
            end
        end
    end
    return nil
end

