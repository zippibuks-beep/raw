    if tick() - lastExportTime >= 5 then
        remote_EventExport:FireServer({
            ["Ping"]       = {[1]=0.024,[2]=0.024,[3]=0.024,[4]=0.024,[5]=0.024,
                              [6]=0.024,[7]=0.024,[8]=0.024,[9]=0.024,[10]=0.024},
