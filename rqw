            -- Thread jual dengan pcall agar tidak stuck jika server lambat reply
            task.spawn(function()
                local ok, result = pcall(function()
                    return rf_sell:InvokeServer()
                end)
                if ok then
                    print("✅ Jual berhasil: " .. tostring(result))
                else
                    warn("❌ Jual error: " .. tostring(result))
